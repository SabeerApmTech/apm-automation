<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors>
      <remove statusCode="400" />
      <error statusCode="400" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\bad_request.html" />
      <remove statusCode="401" />
      <error statusCode="401" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\unauthorized.html" />
      <remove statusCode="403" />
      <error statusCode="403" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\forbidden.html" />
      <remove statusCode="404" />
      <error statusCode="404" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\not_found.html" />
      <remove statusCode="405" />
      <error statusCode="405" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\method_not_allowed.html" />
      <remove statusCode="406" />
      <error statusCode="406" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\not_acceptable.html" />
      <remove statusCode="407" />
      <error statusCode="407" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\proxy_authentication_required.html" />
      <remove statusCode="412" />
      <error statusCode="412" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\precondition_failed.html" />
      <remove statusCode="414" />
      <error statusCode="414" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\request-uri_too_long.html" />
      <remove statusCode="415" />
      <error statusCode="415" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\unsupported_media_type.html" />
      <remove statusCode="500" />
      <error statusCode="500" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\internal_server_error.html" />
      <remove statusCode="501" />
      <error statusCode="501" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\not_implemented.html" />
      <remove statusCode="502" />
      <error statusCode="502" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\bad_gateway.html" />
      <remove statusCode="503" />
      <error statusCode="503" path="F:\Inetpub\vhosts\shatechnologies.in\error_docs\maintenance.html" />
    </httpErrors>
    <tracing>
      <traceFailedRequests>
        <clear />
      </traceFailedRequests>
    </tracing>
  </system.webServer>
  <system.web>
    <compilation tempDirectory="F:\Inetpub\vhosts\shatechnologies.in\tmp" />
  </system.web>
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
